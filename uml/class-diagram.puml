@startuml class-diagram-versione_1
skinparam classAttributeIconSize 0

package "controller" {
    class GestoreMenu {
        - String[] vociMenuBackEnd
        - MenuUtil menuBackEnd
        - GestoreGerarchie gestoreGerarchie
        - GestoreFattori gestoreFattori
        - GestoreComprensorio gestoreComprensorio
        + backEnd(Configuratore configuratore) : void
    }
}

package "gestione_accesso" {
    class GestoreAccesso {
        - HashMap<String, String> mappaCredenzialiConf
        - GestoreFile gestoreFile
        - GestoreConfiguratori gestoreConfiguratori
        - GestoreUtente gestoreUtente
        + accessoConfiguratore(String nomeUtente, String passUtente) : Configuratore
    }

    class MenuAccesso {
        - GestoreAccesso gestoreAccesso
        + loginConfiguratore() : Configuratore
    }
}

package "gestione_file" {
    class GestoreFile {
        - GestoreDati gestoreDati
        + caricaSalvataggio() : void
        + creaSalvataggio() : void
    }

    class GestoreDati {
        - HashMap<Integer, String> comuni
        - HashMap<Integer, ComprensorioGeografico> comprensori
        - HashMap<String, Gerarchia> gerarchie
        - HashMap<String, String> credenzialiConfiguratori
        - HashMap<String, FattoriConversione> fattori
        + getGerarchie() : HashMap<String, Gerarchia>
    }
}

package "model.comprensori" {
    class ComprensorioGeografico {
        - int codice
        - List<String> listaComuni
        + getCodice() : int
        + getListaComuni() : List<String>
    }

    class GestoreComprensorio {
        - HashMap<Integer, ComprensorioGeografico> mappaComprensori
        - GestoreFile gestoreFile
        + modificaComprensori() : void
    }
}

package "model.fattori" {
    class FattoriConversione {
        - Categoria categoria1
        - Categoria categoria2
        - double valoreConversione
        + getCategoria1() : Categoria
        + getCategoria2() : Categoria
    }

    class GestoreFattori {
        - HashMap<String, FattoriConversione> mappaFattori
        - GestoreGerarchie gestoreGerarchie
        + modificaFattori() : void
    }
}

package "model.gerarchie" {
    class Categoria {
        - String nome
        - String descrizione
        - Categoria padre
        + getNome() : String
        + getDescrizione() : String
    }

    class Gerarchia {
        - HashMap<String, Categoria> sottoCategorie
        - Categoria categoriaRadice
        + getCategoria(String nomeCategoria) : Categoria
    }

    class GestoreGerarchie {
        - HashMap<String, Gerarchia> radici
        + modificaGerarchia() : void
    }
}

package "model.utenti" {
    class Utente {
        - String nomeUtente
        - String password
        + getNomeUtente() : String
        + getPassword() : String
    }

    class Configuratore {
    }

    class GestoreConfiguratori {
        - Map<String, Configuratore> mappaConfiguratori
        + trovaConfiguratore(String nomeUtente) : Configuratore
    }

    class GestoreUtente {
        - ArrayList<String> elencoNomi
        + aggiungiUtente(String nomeUtente) : void
    }
}

GestoreMenu --> GestoreGerarchie
GestoreMenu --> GestoreFattori
GestoreMenu --> GestoreComprensorio
GestoreAccesso --> GestoreFile
GestoreAccesso --> GestoreConfiguratori
GestoreAccesso --> GestoreUtente
MenuAccesso --> GestoreAccesso
GestoreFile --> GestoreDati
GestoreDati --> Gerarchia
GestoreDati --> ComprensorioGeografico
GestoreDati --> FattoriConversione
GestoreComprensorio --> GestoreFile
GestoreFattori --> GestoreGerarchie
GestoreGerarchie --> Gerarchia
Gerarchia --> Categoria
Configuratore --> Utente
GestoreConfiguratori --> Configuratore
GestoreUtente --> Utente

@enduml
