@startuml class-diagram-versione_4

!pragma layout smetana
skinparam horizontalAlignment center
skinparam wrapWidth 200
skinparam maxMessageSize 200

package it.ingbs.ingegneria_software.model {
    class Main {
        +main(String[] args)
    }
}

package it.ingbs.ingegneria_software.controller {
    class GestoreMenu {
        +backEnd(Configuratore configuratore)
    }
}

package it.ingbs.ingegneria_software.gestione_accesso {
    class GestoreAccesso {
        +caricaDatiFruitori()
    }
    class MenuAccesso {
        +loginConfiguratore(): Configuratore
        +menuFruitore(GestoreMenu sistemaGenerale): void
    }
}

package it.ingbs.ingegneria_software.gestione_file {
    class GestoreDati {
        +getCredenzialiConfiguratori(): HashMap<String, String>
        +getCredenzialiFruitori(): HashMap<String, String>
        +getDatiFruitori(): HashMap<String, Fruitore>
        +setDatiFruitori(HashMap<String, Fruitore>)
    }
    class GestoreFile {
        +caricaSalvataggio()
        +creaSalvataggio()
        +getGestoreDati(): GestoreDati
    }
}

package it.ingbs.ingegneria_software.model.comprensori {
    class ComprensorioGeografico {
        +getCodice(): int
    }
    class GestoreComprensorio {
        +visualizzaComprensori()
        +getComprensorio(int codice): ComprensorioGeografico
    }
}

package it.ingbs.ingegneria_software.model.utenti {
    class Utente {
        +getNomeUtente(): String
        +setNomeUtente(String userName): void
        +getPassword(): String
        +setPassword(String password): void
    }
    class Configuratore {
        +Configuratore(String nomeUtente, String passwordUtente)
    }
    class Fruitore {
        +getEmail(): String
        +getComprensorio(): int
        +infoFruitore(): void
        +aggiungiRichiesta(RichiestaScambio rs): void
        +getElencoRichieste(): ArrayList<RichiestaScambio>
    }
    class GestoreUtente {
        +aggiungiUtente(String nomeUtente): void
        +controlloUtente(String nomeUtente): boolean
    }
    class GestoreFruitori {
        +creaUtenteFruitore(): Fruitore
        +aggiungiDati(String nomeUtente, String password): void
        +visualizzaFruitori(): void
        +trovaFruitore(String nomeUtente): Fruitore
    }
    class GestoreConfiguratori {
        +creaUtenteConfiguratore(): Configuratore
        +trovaConfiguratore(String nomeUtente): Configuratore
    }
}

GestoreFile --> GestoreDati : "1"
GestoreDati --> ComprensorioGeografico : "1..*"
GestoreMenu --> Configuratore : "1"
MenuAccesso --> GestoreAccesso : "1"
MenuAccesso --> GestoreMenu : "1"
GestoreAccesso --> GestoreDati : "1"
GestoreAccesso --> GestoreFile : "1"
GestoreComprensorio --> ComprensorioGeografico : "1..*"
GestoreUtente --> Utente : "1..*"
GestoreFruitori --> Fruitore : "1..*"
GestoreFruitori --> GestoreUtente : "1"
GestoreFruitori --> GestoreComprensorio : "1"
GestoreFruitori --> GestoreDati : "1"
GestoreConfiguratori --> Configuratore : "1..*"
GestoreConfiguratori --> GestoreDati : "1"

Utente <|-- Configuratore
Utente <|-- Fruitore

@enduml